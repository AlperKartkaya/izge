# Copy to /etc/izge/backend.env on the EC2 host and edit before first boot.
# The frontend is served from app.izge.dev and calls /api on the same origin.

IZGE_APP_NAME=Izge Backend
IZGE_API_PREFIX=/api
IZGE_WORKSPACE_NAME=Izge Company Workspace
IZGE_WORKSPACE_DESCRIPTION=Decision intelligence workspace

# Default credentials match the product sign-in shortcuts.
# Change these before any shared or production deployment.
IZGE_DEFAULT_ADMIN_EMAIL=admin@example.com
IZGE_DEFAULT_ADMIN_PASSWORD=change-me-admin
IZGE_DEFAULT_ADMIN_DISPLAY_NAME=Izge Admin
# Set true only when an already-seeded admin account should be reconciled to
# the configured password after a deploy restart.
IZGE_SYNC_DEFAULT_ADMIN_PASSWORD=true

# Runtime data lives outside the checked-out code so deploys can replace code safely.
IZGE_SQLITE_PATH=/srv/izge/data/izge.db
IZGE_STORAGE_ROOT=/srv/izge/data/storage
IZGE_PASTED_TEXT_ROOT=/srv/izge/data/pasted
IZGE_BOOTSTRAP_ADMIN_CREDENTIALS_PATH=/srv/izge/data/bootstrap_admin_credentials.json

IZGE_TOKEN_TTL_HOURS=24
IZGE_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
IZGE_AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
IZGE_SESSION_COOKIE_NAME=izge_session
IZGE_MAX_UPLOAD_BYTES=10485760
IZGE_MAX_PASTED_TEXT_BYTES=2097152
IZGE_MAX_PDF_PAGES=50
IZGE_MAX_EXTRACTED_TEXT_CHARS=500000

# Set true only after this deployment has a local/private model gateway.
# For customer production, point this at the customer-controlled inference gateway.
IZGE_LOCAL_LLM_ENABLED=false
IZGE_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
IZGE_LOCAL_LLM_MODEL=qwen3.5:4b
IZGE_LOCAL_LLM_TIMEOUT_SECONDS=60

# İzge agent model provider. Keep Ollama as the private-by-default choice.
# Choices: ollama, onprem, glm, deepseek, codex
IZGE_AGENT_MODEL_PROVIDER=ollama
IZGE_AGENT_MODEL_EFFORT=none

# Enable only for the public mock-data demo, not a customer's private deployment.
IZGE_PUBLIC_DEMO_ENABLED=false
IZGE_PUBLIC_DEMO_HOURLY_LIMIT=10
# Enable only behind Railway's public edge; direct/private ingress is not trusted.
IZGE_TRUST_RAILWAY_PROXY=false

# Shared company-owned OpenAI-compatible inference server. Public hosts are rejected by default.
# IZGE_AGENT_ONPREM_BASE_URL=http://model.internal:8000/v1
# IZGE_AGENT_ONPREM_MODEL=company-model
# IZGE_AGENT_ONPREM_API_KEY=read-from-a-private-env-file
# IZGE_AGENT_ALLOW_PUBLIC_ONPREM_URL=false

# Cloud provider keys leave company infrastructure. Store them only in the host's private env file.
# IZGE_AGENT_GLM_API_KEY=...
# IZGE_AGENT_DEEPSEEK_API_KEY=...

# Host-side bridge for the existing Codex ChatGPT login; never mount ~/.codex into the app container.
# IZGE_AGENT_CODEX_BRIDGE_BASE_URL=http://host.docker.internal:8766
# IZGE_AGENT_CODEX_BRIDGE_TOKEN=generate-a-long-random-secret

# Optional agent tools. Keep keys/connectors in the private backend env file.
# IZGE_AGENT_WEB_SEARCH_KEY=...
# IZGE_AGENT_MCP_CONNECTORS_JSON=[]

# Optional LLM-assisted reasoning (each flag is independent of LOCAL_LLM_ENABLED).
# Keep false until the configured local/private model passes smoke tests; deterministic reasoning remains the authority.
IZGE_LLM_QUERY_ROUTING_ENABLED=false
IZGE_LLM_ANSWER_SYNTHESIS_ENABLED=false
IZGE_LLM_SIGNAL_EXPLANATION_ENABLED=false
# Keep false for local-first/private inference; setting true allows public LLM URLs intentionally.
IZGE_ALLOW_PUBLIC_LLM_BASE_URL=false

# Optional frontend build values for sign-in defaults if you build with Vite env.
# Current source defaults are admin@example.com / change-me-admin.
# VITE_DEFAULT_ADMIN_EMAIL=admin@example.com
# VITE_DEFAULT_ADMIN_PASSWORD=change-me-admin
# Deprecated compatibility names still read by the frontend if the default names are absent:
# VITE_DEMO_ADMIN_EMAIL=admin@example.com
# VITE_DEMO_ADMIN_PASSWORD=change-me-admin
